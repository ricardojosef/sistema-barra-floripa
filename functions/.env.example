# Copie este arquivo para "functions/.env" e preencha.
# NÃO coloque senhas aqui: SMTP_USER e SMTP_PASS vão para o cofre com
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set SMTP_PASS
# Veja docs/GUIA.md, seção 7.

# Endereço do site publicado, sem barra no final (usado nos botões dos e-mails).
SITE_URL=https://barrafloripasurfschool.com.br

# Servidor de envio. Brevo: smtp-relay.brevo.com / 587. Gmail: smtp.gmail.com / 465.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Quem aparece como remetente. Precisa ser um endereço autorizado no provedor.
EMAIL_REMETENTE="Barra Floripa Surf School <contato@barrafloripasurfschool.com.br>"

# Para onde vão as respostas dos alunos (opcional).
EMAIL_RESPOSTA=contato@barrafloripasurfschool.com.br

# Pagamentos (seção 6) — deixe como está até ligar o PayPal.
PAYPAL_API=https://api-m.sandbox.paypal.com
