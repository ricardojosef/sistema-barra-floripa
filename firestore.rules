rules_version = '2';

// Regras de segurança do Firestore — Barra Floripa Surf School
//
// Cole este arquivo em: Console do Firebase > Firestore Database > Regras.
//
// Princípio: o papel do usuário (aluno/professor/admin) é lido SEMPRE do
// documento `usuarios/{uid}` no servidor, nunca de algo que o navegador
// envie. Assim, mesmo que alguém altere o JavaScript da página, não
// consegue se promover a administrador nem ler dados de outros alunos.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------

    function autenticado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function papel() {
      return autenticado() ? meuPerfil().papel : 'anonimo';
    }

    function ehAdmin() {
      return papel() == 'admin';
    }

    function ehEquipe() {
      return papel() == 'professor' || papel() == 'admin';
    }

    function ehDono(alunoId) {
      return autenticado() && request.auth.uid == alunoId;
    }

    // No próprio perfil, o usuário só muda telefone e foto (tela "Meu
    // perfil") e a marca de tutorial visto. Nome, e-mail, papel e ativo
    // ficam travados — só o administrador altera.
    function soCamposDoPerfil() {
      let mudou = request.resource.data.diff(resource.data).affectedKeys();
      return mudou.hasOnly(['telefone', 'fotoUrl', 'tutorialConcluido', 'atualizadoEm'])
          && (!('fotoUrl' in request.resource.data)
              || request.resource.data.fotoUrl == null
              || (request.resource.data.fotoUrl is string
                  && request.resource.data.fotoUrl.size() < 300000))
          && (!('telefone' in request.resource.data)
              || (request.resource.data.telefone is string
                  && request.resource.data.telefone.size() <= 20));
    }

    // ---------- usuarios ----------
    match /usuarios/{usuarioId} {
      // Cada um lê o próprio perfil; a equipe lê todos (para montar turmas).
      allow read: if ehDono(usuarioId) || ehEquipe();

      // No cadastro o usuário cria o próprio documento, sempre como 'aluno'.
      // O administrador também cria perfis — é assim que entra um professor
      // novo (a conta nasce em js/equipe.js). Ele não pode criar outro admin.
      allow create: if (ehDono(usuarioId)
                        && request.resource.data.papel == 'aluno'
                        && request.resource.data.ativo == true)
                    || (ehAdmin()
                        && request.resource.data.papel in ['aluno', 'professor']);

      // Cada um edita telefone e foto do próprio perfil; o resto, só o admin.
      allow update: if (ehDono(usuarioId) && soCamposDoPerfil()) || ehAdmin();

      allow delete: if ehAdmin();
    }

    // ---------- professores ----------
    match /professores/{professorId} {
      allow read: if true;            // a landing mostra a equipe
      allow write: if ehAdmin();      // só o administrador renomeia/desativa
    }

    // ---------- pacotes (catálogo de preços) ----------
    match /pacotes/{pacoteId} {
      allow read: if true;            // preços são públicos
      allow write: if ehAdmin();
    }

    // ---------- locais ----------
    match /locais/{localId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // ---------- config ----------
    match /config/{documento} {
      allow read: if true;            // horários e capacidade são públicos
      allow write: if ehAdmin();
    }

    // ---------- compras ----------
    match /compras/{compraId} {
      allow read: if ehDono(resource.data.alunoId) || ehEquipe();

      // O aluno registra a própria compra, sempre como 'pendente'.
      allow create: if ehDono(request.resource.data.alunoId)
                    && request.resource.data.status == 'pendente';

      // ATENÇÃO (produção): marcar como 'pago' deveria ser feito APENAS pelo
      // backend que recebe o webhook do gateway, usando o Admin SDK (que
      // ignora estas regras). Enquanto o projeto roda em modo demonstração,
      // a linha abaixo permite ao próprio aluno confirmar — troque por
      // `allow update: if false;` assim que ligar o pagamento real.
      allow update: if ehDono(resource.data.alunoId) || ehAdmin();

      allow delete: if ehAdmin();
    }

    // ---------- creditos (extrato) ----------
    match /creditos/{lancamentoId} {
      allow read: if ehDono(resource.data.alunoId) || ehEquipe();

      // Mesma observação das compras: em produção, emitir crédito é papel do
      // backend. O aluno pode lançar apenas débito (-1 ao agendar) e o
      // estorno vem de um cancelamento validado.
      allow create: if ehDono(request.resource.data.alunoId) || ehEquipe();

      // Lançamento é imutável: corrigir se faz com um novo lançamento de
      // ajuste, preservando a trilha de auditoria.
      allow update, delete: if false;
    }

    // ---------- agendamentos ----------
    match /agendamentos/{agendamentoId} {
      // O aluno vê as próprias aulas; a equipe vê todas.
      allow read: if ehDono(resource.data.alunoId) || ehEquipe();

      allow create: if ehDono(request.resource.data.alunoId)
                    && request.resource.data.status == 'confirmado'
                    && request.resource.data.duracaoMin is number;

      // Aluno cancela a própria aula; a equipe cancela qualquer uma.
      allow update: if (ehDono(resource.data.alunoId)
                        && request.resource.data.status == 'cancelado')
                    || ehEquipe();

      allow delete: if ehAdmin();
    }

    // ---------- vagas (lotação pública das turmas) ----------
    //
    // Só números: { data, professorId, horario, ocupados, individual }.
    // Qualquer usuário logado lê — é o que o calendário do aluno mostra —,
    // sem expor quem são os outros alunos (isso fica em `agendamentos`).
    //
    // Um aluno só altera a contagem em +1 junto com a criação de uma aula
    // própria, ou em −1 junto com o cancelamento de uma aula própria, e
    // nunca acima da capacidade. A conferência usa getAfter(): olha o
    // agendamento como ele fica no fim da mesma transação.
    match /vagas/{vagaId} {
      allow read: if autenticado();

      allow create: if ehEquipe() || (autenticado() && vagaAlteradaPeloAluno(vagaId, 0));
      allow update: if ehEquipe()
                    || (autenticado() && vagaAlteradaPeloAluno(vagaId, resource.data.ocupados));
      allow delete: if ehAdmin();
    }

    function capacidadeGrupo() {
      return exists(/databases/$(database)/documents/config/app)
        ? get(/databases/$(database)/documents/config/app).data.capacidadeGrupo
        : 5;
    }

    function vagaAlteradaPeloAluno(vagaId, ocupadosAntes) {
      let novo = request.resource.data;
      let aula = getAfter(/databases/$(database)/documents/agendamentos/$(novo.ultimoAgendamento)).data;
      let delta = novo.ocupados - ocupadosAntes;
      return novo.ultimoAgendamento is string
        && aula.alunoId == request.auth.uid
        // A vaga alterada tem de ser exatamente a turma daquela aula.
        && vagaId == aula.data + '_' + aula.professorId + '_' + aula.horario.replace(':', '')
        && ((delta == 1 && aula.status == 'confirmado')
            || (delta == -1 && aula.status == 'cancelado'))
        && novo.ocupados >= 0
        && novo.ocupados <= capacidadeGrupo();
    }

    // ---------- disponibilidade dos professores ----------
    match /disponibilidade/{professorId} {
      // Pública para quem está logado: o calendário do aluno depende dela.
      allow read: if autenticado();
      // O próprio professor edita a dele; o administrador edita a de todos.
      allow write: if ehAdmin()
                   || (ehEquipe()
                       && get(/databases/$(database)/documents/professores/$(professorId)).data.usuarioId
                          == request.auth.uid);
    }

    // ---------- mensagens da equipe para os alunos ----------
    // Um documento por aluno destinatário (ver js/mensagens.js).
    match /mensagens/{mensagemId} {
      allow read: if autenticado()
                  && (resource.data.destinatarioId == request.auth.uid
                      || resource.data.remetenteId == request.auth.uid
                      || ehAdmin());

      // Só a equipe envia, e sempre em nome de quem está logado.
      allow create: if ehEquipe() && request.resource.data.remetenteId == request.auth.uid;

      // O aluno só pode marcar a própria mensagem como lida.
      allow update: if (ehDono(resource.data.destinatarioId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lidaEm', 'atualizadoEm']))
                    || ehAdmin();

      allow delete: if ehAdmin()
                    || (ehEquipe() && resource.data.remetenteId == request.auth.uid);
    }

    // ---------- avisos ----------
    match /avisos/{avisoId} {
      allow read: if autenticado();
      allow write: if ehAdmin();
    }

    // ---------- avisosLidos ----------
    match /avisosLidos/{leituraId} {
      allow read: if autenticado();
      // O id é `<alunoId>_<avisoId>`: só o próprio aluno registra a leitura.
      allow create: if ehDono(request.resource.data.alunoId);
      allow update, delete: if ehAdmin();
    }

    // Qualquer coleção não prevista acima fica bloqueada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
