rules_version = '2';

// Regras de segurança do Firestore — Barra Floripa Surf School
//
// Publique com:  firebase deploy --only firestore:rules
// (ou cole em: Console do Firebase > Firestore Database > Regras)
//
// Princípio: o papel do usuário (aluno/professor/admin) é lido SEMPRE do
// documento `usuarios/{uid}` no servidor, nunca de algo que o navegador
// envie. Assim, mesmo que alguém altere o JavaScript da página, não
// consegue se promover a administrador nem ler dados de outros alunos.
//
// O servidor (Cloud Functions, Admin SDK) ignora estas regras: é ele que
// confirma pagamentos e lança créditos de compra em produção.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------

    function autenticado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function papel() {
      return autenticado() ? meuPerfil().papel : 'anonimo';
    }

    function ehAdmin() {
      return papel() == 'admin';
    }

    function ehEquipe() {
      return papel() == 'professor' || papel() == 'admin';
    }

    function ehDono(alunoId) {
      return autenticado() && request.auth.uid == alunoId;
    }

    function configApp() {
      return get(/databases/$(database)/documents/config/app).data;
    }

    // Pagamento simulado (modo demonstração): o navegador confirma a compra.
    // Em produção fica DESLIGADO — só o servidor marca compra como paga e
    // lança crédito de compra. Para testar o modo demo com o Firebase, crie
    // o campo `pagamentoSimulado: true` no documento config/app.
    function pagamentoSimulado() {
      return exists(/databases/$(database)/documents/config/app)
        && configApp().get('pagamentoSimulado', false) == true;
    }

    // No próprio perfil, o usuário muda telefone, foto, idioma, a marca de
    // tutorial visto e completa os dados pessoais. Nome, e-mail, papel e
    // ativo ficam travados. O CPF, depois de gravado, só o admin altera.
    function soCamposDoPerfil() {
      let mudou = request.resource.data.diff(resource.data).affectedKeys();
      return mudou.hasOnly(['telefone', 'fotoUrl', 'tutorialConcluido', 'atualizadoEm',
                            'idioma', 'nacionalidade', 'cpf', 'documento', 'nascimento'])
          && (!mudou.hasAny(['cpf'])
              || resource.data.get('cpf', null) == null
              || resource.data.get('cpf', '') == '')
          && (!('fotoUrl' in request.resource.data)
              || request.resource.data.fotoUrl == null
              || (request.resource.data.fotoUrl is string
                  && request.resource.data.fotoUrl.size() < 300000))
          && (!('telefone' in request.resource.data)
              || (request.resource.data.telefone is string
                  && request.resource.data.telefone.size() <= 25));
    }

    // ---------- usuarios ----------
    match /usuarios/{usuarioId} {
      // Cada um lê o próprio perfil; a equipe lê todos (turmas, baixa por CPF).
      allow read: if ehDono(usuarioId) || ehEquipe();

      // No cadastro o usuário cria o próprio documento, sempre como 'aluno'.
      // O administrador também cria perfis (professor novo, em js/equipe.js).
      allow create: if (ehDono(usuarioId)
                        && request.resource.data.papel == 'aluno'
                        && request.resource.data.ativo == true)
                    || (ehAdmin()
                        && request.resource.data.papel in ['aluno', 'professor']);

      allow update: if (ehDono(usuarioId) && soCamposDoPerfil()) || ehAdmin();

      allow delete: if ehAdmin();
    }

    // ---------- catálogo e configuração (públicos: o fluxo de reserva
    //            funciona antes do login) ----------
    match /professores/{professorId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /pacotes/{pacoteId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /locais/{localId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /config/{documento} {
      allow read: if true;            // horários, capacidade, datas sem aula
      allow write: if ehAdmin();
    }

    // ---------- cupons ----------
    // Qualquer visitante consulta UM cupom pelo código (get), mas ninguém
    // além do admin lista a coleção — os códigos não ficam expostos.
    match /cupons/{codigo} {
      allow get: if true;
      allow list: if ehAdmin();
      allow create, delete: if ehAdmin();
      // Demonstração: o navegador conta o uso (+1). Em produção, o servidor.
      allow update: if ehAdmin()
                    || (autenticado() && pagamentoSimulado()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos', 'atualizadoEm'])
                        && request.resource.data.usos == resource.data.get('usos', 0) + 1);
    }

    // ---------- compras ----------
    match /compras/{compraId} {
      allow read: if ehDono(resource.data.alunoId) || ehEquipe();

      // O aluno registra a própria compra, sempre como 'pendente'. Valor,
      // cupom e créditos são recalculados pelo servidor antes de cobrar.
      allow create: if ehDono(request.resource.data.alunoId)
                    && request.resource.data.status == 'pendente';

      // O aluno pode: desistir da compra pendente; atualizar o andamento da
      // reserva (aula agendada depois do pagamento). Marcar como paga, só o
      // servidor — ou o navegador no modo demonstração.
      allow update: if ehAdmin()
                    || (ehDono(resource.data.alunoId)
                        && (request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['reservaStatus', 'reservaAgendamentoId', 'reservaErro', 'atualizadoEm'])
                            || (resource.data.status == 'pendente'
                                && request.resource.data.status == 'cancelado'
                                && request.resource.data.diff(resource.data).affectedKeys()
                                     .hasOnly(['status', 'atualizadoEm']))
                            || pagamentoSimulado()));

      allow delete: if ehAdmin();
    }

    // ---------- creditos (extrato) ----------
    //
    // Lançamentos são imutáveis. O aluno só cria:
    //  - débito de 1 crédito ao agendar uma aula própria e confirmada;
    //  - estorno de 1 crédito com id `estorno_<aula>`, quando a própria aula
    //    acaba de ser cancelada. O id fixo impede um segundo estorno.
    // Crédito de compra: servidor (produção) ou demonstração.
    // Ajuste manual: só o administrador.
    match /creditos/{lancamentoId} {
      allow read: if ehDono(resource.data.alunoId) || ehEquipe();

      allow create: if ehAdmin()
                    || (ehEquipe() && request.resource.data.motivo != 'ajuste')
                    || (ehDono(request.resource.data.alunoId) && (
                          debitoDeAgendamento()
                          || estornoDeCancelamento(lancamentoId)
                          || (pagamentoSimulado() && request.resource.data.motivo == 'compra')));

      allow update, delete: if false;
    }

    function aulaDepois(agendamentoId) {
      return getAfter(/databases/$(database)/documents/agendamentos/$(agendamentoId)).data;
    }

    function debitoDeAgendamento() {
      let novo = request.resource.data;
      return novo.motivo == 'agendamento'
        && novo.delta == -1
        && novo.agendamentoId is string
        && aulaDepois(novo.agendamentoId).alunoId == request.auth.uid
        && aulaDepois(novo.agendamentoId).status == 'confirmado';
    }

    function estornoDeCancelamento(lancamentoId) {
      let novo = request.resource.data;
      return novo.motivo == 'cancelamento'
        && novo.delta == 1
        && novo.agendamentoId is string
        && lancamentoId == 'estorno_' + novo.agendamentoId
        && aulaDepois(novo.agendamentoId).alunoId == request.auth.uid
        && aulaDepois(novo.agendamentoId).status == 'cancelado';
    }

    // ---------- agendamentos ----------
    match /agendamentos/{agendamentoId} {
      // O aluno vê as próprias aulas; a equipe vê todas.
      allow read: if ehDono(resource.data.alunoId) || ehEquipe();

      allow create: if (ehDono(request.resource.data.alunoId) || ehEquipe())
                    && request.resource.data.status == 'confirmado'
                    && request.resource.data.duracaoMin is number;

      // Aluno cancela a própria aula; a equipe cancela, registra presença e
      // (o admin) troca o professor.
      allow update: if (ehDono(resource.data.alunoId)
                        && resource.data.status == 'confirmado'
                        && request.resource.data.status == 'cancelado'
                        && request.resource.data.professorId == resource.data.professorId)
                    || ehEquipe();

      allow delete: if ehAdmin();
    }

    // ---------- vagas (lotação pública das turmas) ----------
    //
    // Só números: { data, professorId, horario, ocupados, individual }.
    // Leitura pública: o calendário do fluxo de reserva aparece antes do
    // login, sem expor quem são os alunos (isso fica em `agendamentos`).
    match /vagas/{vagaId} {
      allow read: if true;

      allow create: if ehEquipe() || (autenticado() && vagaAlteradaPeloAluno(vagaId, 0));
      allow update: if ehEquipe()
                    || (autenticado() && vagaAlteradaPeloAluno(vagaId, resource.data.ocupados));
      allow delete: if ehAdmin();
    }

    function capacidadeGrupo() {
      return exists(/databases/$(database)/documents/config/app)
        ? configApp().get('capacidadeGrupo', 5)
        : 5;
    }

    function vagaAlteradaPeloAluno(vagaId, ocupadosAntes) {
      let novo = request.resource.data;
      let aula = getAfter(/databases/$(database)/documents/agendamentos/$(novo.ultimoAgendamento)).data;
      let delta = novo.ocupados - ocupadosAntes;
      return novo.ultimoAgendamento is string
        && aula.alunoId == request.auth.uid
        && vagaId == aula.data + '_' + aula.professorId + '_' + aula.horario.replace(':', '')
        && ((delta == 1 && aula.status == 'confirmado')
            || (delta == -1 && aula.status == 'cancelado'))
        && novo.ocupados >= 0
        && novo.ocupados <= capacidadeGrupo();
    }

    // ---------- disponibilidade dos professores ----------
    match /disponibilidade/{professorId} {
      allow read: if true;            // o calendário público depende dela
      allow write: if ehAdmin()
                   || (ehEquipe()
                       && get(/databases/$(database)/documents/professores/$(professorId)).data.usuarioId
                          == request.auth.uid);
    }

    // ---------- declarações de saúde (PAR-Q + termo) ----------
    // O aluno cria a própria (assinada) e lê as suas; a equipe lê todas
    // (hall de declarações). Ninguém altera um documento assinado.
    match /declaracoes/{declaracaoId} {
      allow read: if ehDono(resource.data.alunoId) || ehEquipe();
      allow create: if ehDono(request.resource.data.alunoId)
                    && request.resource.data.aceiteTermo == true
                    && request.resource.data.assinatura is string
                    && request.resource.data.assinatura.size() < 150000;
      allow update: if false;
      allow delete: if ehAdmin();
    }

    // ---------- justificativas de falta ----------
    match /justificativas/{justificativaId} {
      allow read: if ehDono(resource.data.alunoId) || ehAdmin();
      allow create: if ehDono(request.resource.data.alunoId)
                    && request.resource.data.status == 'pendente'
                    && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId))
                         .data.alunoId == request.auth.uid;
      allow update, delete: if ehAdmin();
    }

    // ---------- repasses (pagamentos da escola aos professores) ----------
    // Cada professor lê só os pagamentos dele (campo professorUsuarioId).
    match /repasses/{repasseId} {
      allow read: if ehAdmin()
                  || (autenticado() && resource.data.professorUsuarioId == request.auth.uid);
      allow write: if ehAdmin();
    }

    // ---------- mensagens da equipe para os alunos ----------
    match /mensagens/{mensagemId} {
      allow read: if autenticado()
                  && (resource.data.destinatarioId == request.auth.uid
                      || resource.data.remetenteId == request.auth.uid
                      || ehAdmin());

      allow create: if ehEquipe() && request.resource.data.remetenteId == request.auth.uid;

      allow update: if (ehDono(resource.data.destinatarioId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lidaEm', 'atualizadoEm']))
                    || ehAdmin();

      allow delete: if ehAdmin()
                    || (ehEquipe() && resource.data.remetenteId == request.auth.uid);
    }

    // ---------- avisos ----------
    match /avisos/{avisoId} {
      allow read: if autenticado();
      allow write: if ehAdmin();
    }

    match /avisosLidos/{leituraId} {
      allow read: if autenticado();
      allow create: if ehDono(request.resource.data.alunoId);
      allow update, delete: if ehAdmin();
    }

    // ---------- registros do servidor (e-mails, notificações) ----------
    match /emails/{id} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    // Qualquer coleção não prevista acima fica bloqueada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
